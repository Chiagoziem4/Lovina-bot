BOT_TOKEN=your_telegram_bot_token_here
LORD_NOCTIS_ID=your_telegram_user_id_here
GROQ_API_KEY=your_groq_api_key_here

# ── AI Provider Selection ──────────────────────────────────────────
# Options: groq | openai | anthropic | gemini | mistral | ollama
AI_PROVIDER=groq

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mistral (optional)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium

# Ollama local (optional — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
RESEARCH_PASSPHRASE=your_secret_passphrase_here
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=

# ── Hungry Spider + Tools Integration ────────────────────────────
# Directory for spider SQLite DB and user data storage
SPIDER_DATA_DIR=data/spider

# Max characters of page text sent to AI for extraction
MAX_CONTENT_CHARS=12000

# Max pages per crawl job
SPIDER_MAX_PAGES=20

# Delay between requests in seconds
SPIDER_DELAY=2.0

# Randomise delay with jitter
SPIDER_RANDOMISE_DELAY=true
